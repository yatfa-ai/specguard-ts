{
  "name": "specguard-ts",
  "version": "0.0.0",
  "description": "The TypeScript client for SpecGuard: node:test and Vitest reporters that ship test-run telemetry.",
  "license": "MIT",
  "homepage": "https://github.com/yatfa-ai/specguard-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yatfa-ai/specguard-ts.git"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/yatfa-ai/specguard-ts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "//": "Slices 1-5 ship the runner-agnostic core, the node:test adapter (`./node-test`), the lint command, and the Vitest adapter (`./vitest`). The Jest adapter and the `specguard-ingest` replay bin arrive with later slices; nothing is declared here that does not exist.",
  "exports": {
    ".": "./dist/index.js",
    "./node-test": "./dist/node-test/reporter.js",
    "./vitest": "./dist/vitest/reporter.js",
    "./lint": "./dist/lint/index.js"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "bin": {
    "specguard": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --project tsconfig.test.json",
    "test": "node --test \".test-build/test/\"",
    "prepare": "npm run build"
  },
  "devDependencies": {},
  "dependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.19.0"
  }
}

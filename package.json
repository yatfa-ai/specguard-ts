{
  "name": "specguard-ts",
  "version": "0.0.0",
  "description": "The TypeScript client for SpecGuard: a node:test reporter that ships test-run telemetry.",
  "license": "MIT",
  "homepage": "https://github.com/yatfa-ai/specguard-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yatfa-ai/specguard-ts.git"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/yatfa-ai/specguard-ts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "//": "Slice 1 ships the runner-agnostic core and the node:test adapter (`./node-test`). The Vitest and Jest adapters (and the `specguard-lint` / `specguard-ingest` bins below) arrive with later slices; nothing is declared as an export that does not exist.",
  "exports": {
    ".": "./dist/index.js",
    "./node-test": "./dist/node-test/reporter.js"
  },
  "bin": {
    "specguard-lint": "./dist/bin/specguard-lint.js",
    "specguard-ingest": "./dist/bin/specguard-ingest.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --project tsconfig.test.json",
    "test": "node --test \".test-build/test/\""
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.0"
  }
}
